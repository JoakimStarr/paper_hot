# ─────────────────────────────────────────────────────────────
# PaperPulse 后端配置示例
# 复制为 backend/.env 后按需修改：cp backend/.env.example backend/.env
#
# ★ 优先级说明：
#   系统设置页（/system）保存的用户配置持久化到数据库 system_settings 表，
#   优先级高于本文件；本文件仅作为初始基线（首次启动引导）。
#
# 注意：本文件只允许出现以下键（pydantic-settings 禁止未知键，多余键会导致启动报错）。
# ─────────────────────────────────────────────────────────────

# 数据库连接。默认 SQLite（推荐，聚合 SQL 使用 SQLite 方言，暂不建议换 Postgres）。
# 若要自定义路径：
# DATABASE_URL=sqlite+aiosqlite:///./data/paperpulse.db

# ── AI 服务密钥（至少配置一个 provider 才能使用 AI 功能）──
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
OPENAI_API_KEY=

# 内置 provider 的 OpenAI 兼容端点覆盖（留空用默认地址）
# ZHIPU_BASE_URL=
# SILICONFLOW_BASE_URL=
# OPENAI_BASE_URL=

# 各 provider 模型优先级（JSON 数组字符串；也可在系统页排序，保存进数据库）
# ZHIPU_MODELS=["glm-4-flash","glm-4-plus"]
# SILICONFLOW_MODELS=["Qwen/Qwen2.5-7B-Instruct"]
# OPENAI_MODELS=["gpt-4o-mini"]

# 自定义 OpenAI 兼容 provider（JSON 数组字符串）
# CUSTOM_PROVIDERS=[{"name":"my-provider","base_url":"https://api.example.com/v1","api_key":"sk-...","models":["model-a"]}]

# 全局默认模型（格式 provider/model）；留空自动选择
# DEFAULT_MODEL=zhipu/glm-4-flash

# 选题验证器 embedding 模型（格式 provider/model）；留空按可用性自动选择
# EMBEDDING_MODEL=zhipu/embedding-3

# 选题验证器两阶段检索的重排（默认硅基流动 bge-reranker-v2-m3）：
# 本地 embedding 召回 Top-N 后精排。留空/不配 key 自动跳过重排，降级为 embedding 顺序。
# RERANK_MODEL=siliconflow/BAAI/bge-reranker-v2-m3
# RERANK_API_KEY=sk-...
# RERANK_BASE_URL=https://api.siliconflow.cn/v1

# 定时爬取开关。服务器部署建议 false（爬虫在别处执行），本地 true
SCHEDULER_ENABLED=true

# API Token：设置后受保护接口需携带 x-api-token 头；留空不启用
API_TOKEN=

# CNKI 爬虫是否无头模式（false 弹出浏览器窗口便于人工过验证码）
CNKI_HEADLESS=false

# CNKI 论文详情跳转链接的域名头（高校 VPN/镜像地址），留空用知网官网
CNKI_URL_PREFIX=

# arXiv 抓取的分类列表
# ARXIV_CATEGORIES=["cs.AI","cs.CL","cs.LG","cs.CV"]

# 服务端口（★ 此二键会被 start.sh 在启动前读取，修改后需重启生效）
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS 允许来源（JSON 数组）
# CORS_ORIGINS=["http://localhost:3000"]

# ── 日志系统 ──
# 日志级别：DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO
# 是否写滚动文件日志（backend/data/logs/app.log，5MB × 5 轮转）；false 仅控制台
# LOG_FILE_ENABLED=false
# 日志文件路径
# LOG_FILE_PATH=./data/logs/app.log
# 启动时清理超过该天数的动作/错误日志（0 表示不清理）
# LOG_RETENTION_DAYS=30

# 追问 Agent（工具检索）开关：true=AI 追问可调用工具检索论文库；false=退化为普通对话（不检索）
# AGENT_ENABLED=false
